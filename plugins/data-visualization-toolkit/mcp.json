{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "data-explorer": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/scripts/data_explorer_mcp.py"
      ],
      "cwd": "./",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
