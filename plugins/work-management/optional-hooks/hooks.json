{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/codex_work_start.py\" --portable",
            "commandWindows": "python -I \"${PLUGIN_ROOT}/scripts/codex_work_start.py\" --portable",
            "timeout": 3,
            "statusMessage": "Route skills and tools"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/decision_review_hint.py\"",
            "commandWindows": "python -I \"${PLUGIN_ROOT}/scripts/decision_review_hint.py\"",
            "timeout": 3,
            "statusMessage": "Prompt an idea review"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/codex_coordinator_session_start.py\"",
            "commandWindows": "python -I \"${PLUGIN_ROOT}/scripts/codex_coordinator_session_start.py\"",
            "timeout": 5,
            "statusMessage": "Load shared-work assignments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/codex_coordinator_stop_guard.py\"",
            "commandWindows": "python -I \"${PLUGIN_ROOT}/scripts/codex_coordinator_stop_guard.py\"",
            "timeout": 5,
            "statusMessage": "Check shared-work handoff"
          }
        ]
      }
    ]
  }
}
