{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Source Lock",
  "type": "object",
  "required": ["reviewed_at", "policy", "sources"],
  "properties": {
    "reviewed_at": {"type": "string"},
    "policy": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "kind", "license", "usage", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "kind": {"type": "string"},
          "license": {"type": "string"},
          "usage": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
