{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-production-workflow/animation-slot.schema.json",
  "title": "Animation Slot",
  "type": "object",
  "required": ["id", "renderer", "width", "height", "fps", "duration", "output"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "renderer": {"enum": ["ffmpeg", "hyperframes", "motion-canvas", "manim", "blender", "remotion", "custom"]},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "alpha": {"type": "boolean", "default": false},
    "color_space": {"type": "string", "default": "bt709"},
    "style_tokens": {"type": "object"},
    "assets": {"type": "object"},
    "payload": {"type": "object"},
    "output": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
