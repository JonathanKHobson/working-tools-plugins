{
  "name": "creative-writing-studio",
  "version": "0.3.2",
  "description": "Creative project routing for stories, games, GM prep, craft, provenance, and publishing.",
  "author": {
    "name": "Jonathan Kyle Hobson"
  },
  "license": "AGPL-3.0-only AND CC-BY-SA-4.0",
  "keywords": [
    "story",
    "fiction",
    "horror",
    "story-atlas",
    "creative",
    "ttrpg",
    "game-design"
  ],
  "repository": "https://github.com/JonathanKHobson/working-tools-plugins",
  "homepage": "https://working-tools.jkylehobson.chatgpt.site/",
  "mcpServers": {
    "ttrpg-compass": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/ttrpg_compass_mcp.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "draw-think": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/draw_think_mcp.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "creative-atlas": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/atlas_library_mcp.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
