{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ux-heuristic-compass": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/scripts/compass_mcp.py",
        "ux-heuristic-compass"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
