{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/design_runtime.py\" hook post --project .",
            "timeout": 5,
            "statusMessage": "Track frontend review tasks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/design_runtime.py\" hook stop --project .",
            "timeout": 30,
            "statusMessage": "Check frontend review completion"
          }
        ]
      }
    ]
  }
}
