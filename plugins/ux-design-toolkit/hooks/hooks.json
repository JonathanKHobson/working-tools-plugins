{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/design_runtime.py\" hook post --project .",
            "timeout": 5,
            "statusMessage": "UX Design Studio: review opted-in frontend changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/design_runtime.py\" hook stop --project .",
            "timeout": 30,
            "statusMessage": "UX Design Studio: complete opted-in review"
          }
        ]
      }
    ]
  }
}
