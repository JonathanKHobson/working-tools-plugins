{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/survey-strategist/survey.schema.json",
  "title": "Survey Strategist canonical instrument",
  "description": "A platform-neutral source of truth for survey content, logic, analysis metadata, consent, privacy, and exports.",
  "type": "object",
  "required": [
    "survey",
    "analysis_plan",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "survey": {
      "$ref": "#/$defs/surveyMetadata"
    },
    "analysis_plan": {
      "$ref": "#/$defs/analysisPlan"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "surveyMetadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "objective",
        "target_audience",
        "mode",
        "estimated_minutes",
        "consent",
        "privacy"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "objective": {
          "type": "string",
          "minLength": 10
        },
        "target_audience": {
          "type": "string",
          "minLength": 10
        },
        "mode": {
          "type": "string",
          "enum": [
            "web",
            "mobile",
            "email",
            "intercept",
            "paper",
            "phone",
            "in_person",
            "mixed",
            "other"
          ]
        },
        "estimated_minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string"
        },
        "decision_deadline": {
          "type": "string"
        },
        "consent": {
          "$ref": "#/$defs/consent"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        }
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "required",
        "text",
        "contact"
      ],
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 10
        },
        "contact": {
          "type": "string",
          "minLength": 3
        },
        "withdrawal": {
          "type": "string"
        },
        "incentive": {
          "type": "string"
        },
        "irb_or_ethics_review": {
          "type": "string"
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "identifiability",
        "collects_pii",
        "retention",
        "jurisdictions"
      ],
      "additionalProperties": true,
      "properties": {
        "identifiability": {
          "type": "string",
          "enum": [
            "anonymous",
            "pseudonymous",
            "identified"
          ]
        },
        "collects_pii": {
          "type": "boolean"
        },
        "retention": {
          "type": "string",
          "minLength": 8
        },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "data_controller": {
          "type": "string"
        },
        "data_processor": {
          "type": "string"
        },
        "sensitive_data": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "security_notes": {
          "type": "string"
        }
      }
    },
    "analysisPlan": {
      "type": "object",
      "required": [
        "decisions",
        "primary_metrics",
        "segments",
        "exclusions"
      ],
      "additionalProperties": true,
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "primary_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_size_basis": {
          "type": "string"
        },
        "missing_data_plan": {
          "type": "string"
        },
        "open_text_plan": {
          "type": "string"
        },
        "decision_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "logic": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "question_id",
            "operator"
          ],
          "additionalProperties": true,
          "properties": {
            "question_id": {
              "$ref": "#/$defs/identifier"
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "not_equals",
                "contains",
                "not_contains",
                "selected",
                "not_selected",
                "greater_than",
                "less_than",
                "answered",
                "not_answered"
              ]
            },
            "value": {}
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "label",
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "exclusive": {
          "type": "boolean"
        },
        "open_text": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "scale": {
      "type": "object",
      "required": [
        "min",
        "max",
        "step",
        "anchors"
      ],
      "additionalProperties": true,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchors": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_not_applicable": {
          "type": "boolean"
        },
        "not_applicable_label": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text",
        "required",
        "rationale",
        "construct",
        "analysis_use"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "export_tag": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "single_choice",
            "multi_choice",
            "dropdown",
            "yes_no",
            "likert",
            "rating",
            "nps",
            "slider",
            "number_scale",
            "matrix",
            "likert_matrix",
            "bipolar_matrix",
            "rank_order_matrix",
            "constant_sum_matrix",
            "text_entry_matrix",
            "side_by_side",
            "text",
            "textarea",
            "numeric",
            "date",
            "calendar",
            "rank",
            "constant_sum",
            "maxdiff",
            "pick_group_rank",
            "drilldown",
            "form",
            "file_upload",
            "signature",
            "heatmap",
            "hotspot",
            "highlight",
            "video",
            "descriptive",
            "timing",
            "captcha"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "help_text": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "required_justification": {
          "type": "string",
          "minLength": 20
        },
        "screening": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        },
        "construct": {
          "type": "string",
          "minLength": 2
        },
        "analysis_use": {
          "type": "string",
          "minLength": 8
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": true
        },
        "display_if": {
          "$ref": "#/$defs/logic"
        },
        "skip_to": {
          "$ref": "#/$defs/identifier"
        },
        "randomize_choices": {
          "type": "boolean"
        },
        "reverse_scored": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "pii": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "platform_notes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single_choice",
                  "multi_choice",
                  "dropdown",
                  "yes_no",
                  "rank",
                  "constant_sum",
                  "maxdiff",
                  "pick_group_rank",
                  "drilldown"
                ]
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "likert",
                  "rating",
                  "nps",
                  "slider",
                  "number_scale"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "matrix",
                  "likert_matrix",
                  "bipolar_matrix",
                  "rank_order_matrix",
                  "constant_sum_matrix",
                  "text_entry_matrix",
                  "side_by_side"
                ]
              }
            }
          },
          "then": {
            "required": [
              "rows",
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "title",
        "questions"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "randomize": {
          "type": "boolean"
        },
        "display_if": {
          "$ref": "#/$defs/logic"
        },
        "page_break_after": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    }
  }
}
