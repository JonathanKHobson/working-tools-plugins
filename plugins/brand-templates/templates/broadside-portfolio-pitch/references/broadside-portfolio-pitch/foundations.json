      "text": [
        "WORK SPECIMEN / ORIGINAL FICTIONAL COPY",
        "ARTIFACT A / AUTHORSHIP AND LIMITS STAY VISIBLE / 03",
        "An invitation without a demand",
        "Choose a door. Tell us what you leave behind. You may listen instead.",
        "Proposed opening card / participatory story workshop",
        "MY DECISION",
        "I made listening a valid form of participation and kept the invitation short.",
        "STILL TO LEARN",
        "Check comfort, clarity and reading access with intended participants before delivery."
      ],
      "shapes": {
        "sp": 9
      }
    },
