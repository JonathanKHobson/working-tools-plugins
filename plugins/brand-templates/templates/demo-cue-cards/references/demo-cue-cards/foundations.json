  "paragraphs": [
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "01 / Set the purpose"
    },
    {
      "style": "CueTiming",
      "text": "00:00–00:20 / 20 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“This paper demo separates a temporary preview from an applied filter. No booking or live app is…"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Name the one distinction. Offer the printed frame and text equivalent."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "Observer has a spoken and written route to the same example."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "The intended distinction"
    },
    {
      "style": "CueState",
      "text": "All formats: 3 sample titles Preview: 2 audio titles Apply: the same 2 titles Reset: all 3 titles"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. Next: card 02."
    },
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "02 / Show the baseline"
    },
    {
      "style": "CueTiming",
      "text": "00:20–00:45 / 25 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“All formats shows three example titles: Aster and Cedar are audio; Birch is print.”"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Point to each title and format in this card’s frame."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "Three titles are shown; none is reserved or selected."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "All formats"
    },
    {
      "style": "CueState",
      "text": "Aster / audio Birch / print Cedar / audio 3 of 3 shown"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. Next: card 03."
    },
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "03 / Preview one choice"
    },
    {
      "style": "CueTiming",
      "text": "00:45–01:25 / 40 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“Previewing Audio shows two of the three titles. This is a temporary view; nothing has been applied.”"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Point to the preview label, then name both visible titles."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "Two titles are visible and the status still says Preview only."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "Audio preview"
    },
    {
      "style": "CueState",
      "text": "Aster / audio Cedar / audio 2 of 3 shown Preview only"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. Next: card 04."
    },
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "04 / Apply the choice"
    },
    {
      "style": "CueTiming",
      "text": "01:25–02:05 / 40 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“Apply keeps the same two audio titles in the local view. It does not book, borrow or change a service.”"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Point to Applied locally. Compare it with card 03."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "The visible titles match the preview; the status changes."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "Audio applied"
    },
    {
      "style": "CueState",
      "text": "Aster / audio Cedar / audio 2 of 3 shown Applied locally"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. Next: card 05."
    },
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "05 / Reset the view"
    },
    {
      "style": "CueTiming",
      "text": "02:05–02:40 / 35 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“Reset returns to All formats and restores all three titles. The original list is still available.”"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Point to all three titles. Compare with card 02."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "All three original titles return in the original order."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "All formats restored"
    },
    {
      "style": "CueState",
      "text": "Aster / audio Birch / print Cedar / audio 3 of 3 shown"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. Next: card 06."
    },
    {
      "style": "CueLabel",
      "text": "FICTIONAL PAPER DEMO / PLANNED 180 SECONDS / UNTIMED"
    },
    {
      "style": "Heading1",
      "text": "06 / Close the loop"
    },
    {
      "style": "CueTiming",
      "text": "02:40–03:00 / 20 SEC / READING-LIST FILTER"
    },
    {
      "style": "Heading2",
      "text": "SAY"
    },
    {
      "style": "Normal",
      "text": "“Preview is temporary; Apply keeps the view; Reset restores the list. These paper states show that…"
    },
    {
      "style": "Heading2",
      "text": "SHOW / DO"
    },
    {
      "style": "Normal",
      "text": "Trace Preview → Apply → Reset. Invite one question if time permits."
    },
    {
      "style": "Heading2",
      "text": "CHECK"
    },
    {
      "style": "Normal",
      "text": "End at 03:00 if practical; access needs can require a pause."
    },
    {
      "style": "Heading2",
      "text": "SUPPLIED PAPER STATE"
    },
    {
      "style": "CueStateTitle",
      "text": "Three different states"
    },
    {
      "style": "CueState",
      "text": "PREVIEW / temporary APPLY / local view RESET / all 3 titles No booking or live app"
    },
    {
      "style": "CueNote",
      "text": "Editable specimen only. No live application or observed result."
    },
    {
      "style": "CueRecovery",
      "text": "If the frame is unclear, read it aloud and offer the text equivalent. Pause or stop if needed."
    },
    {
      "style": "CueRecovery",
      "text": "Reset: return to card 02. End: questions or a new rehearsal."
    }
