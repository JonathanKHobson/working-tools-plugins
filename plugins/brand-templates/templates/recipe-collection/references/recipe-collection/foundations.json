  "paragraphs": [
    {
      "style": "RecipeLabel",
      "text": "RECIPE COLLECTION"
    },
    {
      "style": "Title",
      "text": "The shared table"
    },
    {
      "style": "RecipeSubtitle",
      "text": "Two bright bowls for everyday gatherings"
    },
    {
      "style": "RecipeByline",
      "text": "Cedar Community Kitchen / Collection 01"
    },
    {
      "style": "Normal",
      "text": "A little chopping, a little stirring, something good to share. These two simple side dishes begin with…"
    },
    {
      "style": "RecipeContents",
      "text": "At the table"
    },
    {
      "style": "RecipeLink",
      "text": "Lemon & white bean salad / page 2"
    },
    {
      "style": "RecipeLink",
      "text": "Orchard fruit with mint / page 3"
    },
    {
      "style": "RecipeNote",
      "text": "Portions are small side dishes. Ingredient amounts are for the yield stated on each page."
    },
    {
      "style": "RecipeLabel",
      "text": "FICTIONAL COMMUNITY COLLECTION"
    },
    {
      "style": "RecipeLabel",
      "text": "RECIPE 01"
    },
    {
      "style": "Heading1",
      "text": "Lemon & white bean salad"
    },
    {
      "style": "RecipeDescription",
      "text": "Creamy beans, crisp cucumber and a bright parsley dressing."
    },
    {
      "style": "RecipeYield",
      "text": "4 small side portions / Prep: 15 minutes"
    },
    {
      "style": "RecipeEquipment",
      "text": "Equipment: Large bowl, small cup, spoon, sieve, knife, board, scale, measuring jug."
    },
    {
      "style": "Heading2",
      "text": "Ingredients"
    },
    {
      "style": "RecipeNote",
      "text": "Amounts refer to the prepared ingredients listed above."
    },
    {
      "style": "Heading2",
      "text": "Method"
    },
    {
      "style": "RecipeMethod",
      "text": "Start with the bowl Put the drained white beans and diced cucumber into the large bowl."
    },
    {
      "style": "RecipeMethod",
      "text": "Stir the dressing In the small cup, stir together the lemon juice, olive oil and salt."
    },
    {
      "style": "RecipeMethod",
      "text": "Bring it together Stir the parsley into the dressing, then pour it over the beans and cucumber."
    },
    {
      "style": "RecipeMethod",
      "text": "Toss and share Toss gently until everything is coated. Divide into 4 small side portions."
    },
    {
      "style": "Heading2",
      "text": "To serve"
    },
    {
      "style": "RecipeNote",
      "text": "Serve alongside bread or another dish. The ingredient weights refer to the prepared forms listed here."
    },
    {
      "style": "RecipeLink",
      "text": "Return to the collection / page 1"
    },
    {
      "style": "RecipeFolio",
      "text": "02 / 03"
    },
    {
      "style": "RecipeLabel",
      "text": "RECIPE 02"
    },
    {
      "style": "Heading1",
      "text": "Orchard fruit with mint"
    },
    {
      "style": "RecipeDescription",
      "text": "Thin slices of pear and apple, juicy grapes and a light lime dressing."
    },
    {
      "style": "RecipeYield",
      "text": "4 small side portions / Prep: 15 minutes"
    },
    {
      "style": "RecipeEquipment",
      "text": "Equipment: Large bowl, small cup, spoon, knife, board, scale, measuring jug."
    },
    {
      "style": "Heading2",
      "text": "Ingredients"
    },
    {
      "style": "RecipeNote",
      "text": "Amounts refer to the prepared ingredients listed above."
    },
    {
      "style": "Heading2",
      "text": "Method"
    },
    {
      "style": "RecipeMethod",
      "text": "Mix a bright dressing Stir the lime juice and maple syrup together in the small cup."
    },
    {
      "style": "RecipeMethod",
      "text": "Coat the sliced fruit Put the pear and apple into the large bowl. Pour over the dressing and toss gently."
    },
    {
      "style": "RecipeMethod",
      "text": "Add the finishing pieces Fold in the halved grapes and mint, keeping the fruit slices intact."
    },
    {
      "style": "RecipeMethod",
      "text": "Spoon and share Spoon into 4 small side portions, including a little dressing with each."
    },
    {
      "style": "Heading2",
      "text": "To serve"
    },
    {
      "style": "RecipeNote",
      "text": "Serve as a fresh side dish. The fruit weights are measured after removing cores and any stems."
    },
    {
      "style": "RecipeLink",
      "text": "Return to the collection / page 1"
    },
    {
      "style": "RecipeFolio",
      "text": "03 / 03"
    }
  ],
