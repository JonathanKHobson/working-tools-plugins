  "paragraphs": [
    {
      "style": "RouteLabel",
      "text": "FICTIONAL BRIEF"
    },
    {
      "style": "Title",
      "text": "Volunteer pocket guide"
    },
    {
      "style": "RouteEvent",
      "text": "Cedar Open Studio"
    },
    {
      "style": "RouteNote",
      "text": "Welcome volunteer"
    },
    {
      "style": "Normal",
      "text": "Use the numbered stops to check your duties and find the next contact."
    },
    {
      "style": "RouteNote",
      "text": "COS 01 / 2026-10-15"
    },
    {
      "style": "RouteNote",
      "text": "Conceptual route only / Not a site map"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 01 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Arrive"
    },
    {
      "style": "RouteIntro",
      "text": "Confirm the current brief"
    },
    {
      "style": "Heading2",
      "text": "Read the current brief"
    },
    {
      "style": "Normal",
      "text": "Check COS 01 for 2026-10-15. You are the welcome volunteer. Welcome visitors and help them find the…"
    },
    {
      "style": "Heading2",
      "text": "Find both contacts"
    },
    {
      "style": "Normal",
      "text": "Find the duty lead and programme lead before starting. Their locations are on page 6."
    },
    {
      "style": "Heading2",
      "text": "Check the route"
    },
    {
      "style": "Normal",
      "text": "Read Scope on page 3 and Exceptions on page 5. Ask the duty contact about any unclear instruction."
    },
    {
      "style": "RouteNote",
      "text": "Confirm the brief before starting."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "02 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 02 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Scope"
    },
    {
      "style": "RouteIntro",
      "text": "Check your role boundary"
    },
    {
      "style": "Heading2",
      "text": "You can do"
    },
    {
      "style": "Normal",
      "text": "Welcome visitors at the entry desk. Use the current programme to give directions. Watch the room entry…"
    },
    {
      "style": "Heading2",
      "text": "Refer these decisions"
    },
    {
      "style": "Normal",
      "text": "Leave full-room entry decisions to a lead. Ask a lead about changes to session times or locations.…"
    },
    {
      "style": "Heading2",
      "text": "When no one responds"
    },
    {
      "style": "Normal",
      "text": "If neither contact responds, pause the affected task and wait for the duty lead. Do not make the…"
    },
    {
      "style": "RouteNote",
      "text": "A referral does not transfer decision authority to you."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "03 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 03 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Routine"
    },
    {
      "style": "RouteIntro",
      "text": "Follow the task sequence"
    },
    {
      "style": "Heading2",
      "text": "01 Welcome"
    },
    {
      "style": "Normal",
      "text": "Ask which session the visitor wants. Use their answer to choose the next step."
    },
    {
      "style": "Heading2",
      "text": "02 Check"
    },
    {
      "style": "Normal",
      "text": "Read the current programme and room entry sign. If either is unclear, use Exceptions on page 5."
    },
    {
      "style": "Heading2",
      "text": "03 Direct"
    },
    {
      "style": "Normal",
      "text": "Give one clear next destination. Offer the paper programme and allow time for questions."
    },
    {
      "style": "RouteNote",
      "text": "Unclear instruction means ask before continuing."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "04 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 04 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Exceptions"
    },
    {
      "style": "RouteIntro",
      "text": "Choose the right referral"
    },
    {
      "style": "Heading2",
      "text": "01 Room is full or unclear"
    },
    {
      "style": "Normal",
      "text": "Keep visitors outside that room while you ask. Ask Duty lead; backup: Programme lead."
    },
    {
      "style": "Heading2",
      "text": "02 Programme details conflict"
    },
    {
      "style": "Normal",
      "text": "Do not promise a revised time or location. Ask Programme lead; backup: Duty lead."
    },
    {
      "style": "Heading2",
      "text": "03 Support is outside your brief"
    },
    {
      "style": "Normal",
      "text": "Ask what help is wanted without promising an arrangement. Ask Access lead; backup: Duty lead."
    },
    {
      "style": "RouteNote",
      "text": "If both contacts are unavailable, use the hold rule on page 3."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "05 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 05 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Contacts"
    },
    {
      "style": "RouteIntro",
      "text": "Use a primary and backup"
    },
    {
      "style": "Heading2",
      "text": "Duty lead"
    },
    {
      "style": "Normal",
      "text": "Find at: Welcome desk. Confirm presence at check-in."
    },
    {
      "style": "Heading2",
      "text": "Programme lead"
    },
    {
      "style": "Normal",
      "text": "Find at: Programme desk. Confirm presence at check-in."
    },
    {
      "style": "Heading2",
      "text": "Access lead"
    },
    {
      "style": "Normal",
      "text": "Find at: Front desk. Confirm presence at check-in."
    },
    {
      "style": "RouteNote",
      "text": "If the primary contact is unavailable, ask the listed backup. If neither responds, use the hold rule on…"
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "06 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 06 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Handoff"
    },
    {
      "style": "RouteIntro",
      "text": "Pass on unfinished work"
    },
    {
      "style": "Heading2",
      "text": "Record unfinished work"
    },
    {
      "style": "Normal",
      "text": "Note unanswered visitor questions and any paused room direction. Include the question, action taken and…"
    },
    {
      "style": "Heading2",
      "text": "Tell the receiving lead"
    },
    {
      "style": "Normal",
      "text": "Tell the duty lead what remains. Ask them to acknowledge the handoff before leaving the task."
    },
    {
      "style": "Heading2",
      "text": "Keep the status honest"
    },
    {
      "style": "Normal",
      "text": "If nobody accepts, keep the handoff pending and ask the programme lead. Do not mark unresolved work…"
    },
    {
      "style": "RouteNote",
      "text": "No completed handoff is recorded in this guide."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "07 / 08"
    },
    {
      "style": "RouteLabel",
      "text": "STOP 07 OF 07"
    },
    {
      "style": "Heading1",
      "text": "Close"
    },
    {
      "style": "RouteIntro",
      "text": "Confirm before leaving"
    },
    {
      "style": "Heading2",
      "text": "Confirm the handoff"
    },
    {
      "style": "Normal",
      "text": "Check that the duty lead or programme lead has accepted unfinished work. If not, return to Handoff on…"
    },
    {
      "style": "Heading2",
      "text": "Return materials"
    },
    {
      "style": "Normal",
      "text": "Return the programme copies and desk materials to the welcome desk."
    },
    {
      "style": "Heading2",
      "text": "Sign out"
    },
    {
      "style": "Normal",
      "text": "Tell the duty lead you are leaving and follow their sign-out instruction. Record only what actually…"
    },
    {
      "style": "RouteNote",
      "text": "No completed shift is recorded in this guide."
    },
    {
      "style": "RouteLink",
      "text": "Return to route overview / page 1"
    },
    {
      "style": "RouteFolio",
      "text": "08 / 08"
    }
  ],
