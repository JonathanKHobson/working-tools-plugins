  "reviewedEditorial": {
    "overview": "A three-sheet capacity workbook: Overview compares recorded and hypothetical figures, Sessions holds 12 entry rows and guarded calculations, and Definitions explains the terms. Arial 11 pt is used for cells and bold 17 pt titles appear at A2. Dark #243746 headers, pale #EFF3F6 results and amber #FFF2CC input cells distinguish roles.",
    "invariants": [
      "The amber input fill spans the Sessions entry area, including A5:C16 and scenario-seat cells G5:G16; it is not limited to the prefilled first three rows.",
      "Overview formulas reference Sessions totals, including B7=Sessions!B18 and E7=Sessions!G18. The scenario changes capacity while enrollment stays recorded.",
      "Sessions formulas retain blank, Missing input and No capacity outcomes as appropriate. The local PDF uses LiberationSans resources although workbook styles request Arial."
    ],
    "adaptationChecks": [
      "If the 12 entry rows change, update row-18 totals, formulas, validations, conditional formatting and Overview references together.",
      "Exercise blank capacity, zero capacity and overbooking cases; verify unknowns do not become misleading zeroes.",
      "Check edited labels against Overview A=36/C=4/D=30 and Definitions B=73 character widths, and replace the fictional organization label with supported facts."
    ]
  }
