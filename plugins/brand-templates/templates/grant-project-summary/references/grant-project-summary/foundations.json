    {
      "style": "Heading2",
      "text": "Six cost groups"
    },
    {
      "style": "CivicAmount",
      "text": "Estimated total: $5,000"
    },
    {
      "style": "Heading2",
      "text": "How the proposal would be funded"
    },
    {
      "style": "CivicAmount",
      "text": "Total not yet secured: $5,000"
    },
    {
      "style": "CivicNote",
      "text": "The four funding rows sum to the estimated cost. Requested and proposed funds are not secured."
    },
    {
      "style": "CivicNote",
      "text": "All rates are hypothetical estimates, not quotes or approved finances. Confirm access provision and…"
