  "mcpServers": {
    "critical-compass": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/compass_mcp.py",
        "critical-compass"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "critical-review": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/critical_review_mcp.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
