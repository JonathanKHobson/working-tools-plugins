{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "critical-compass": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/compass_mcp.py",
        "critical-compass"
      ],
      "cwd": "./",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "critical-review": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/critical_review_mcp.py"
      ],
      "cwd": "./",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
